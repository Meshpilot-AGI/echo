# cod-pipecat local overrides. Shared secrets (VOBIZ_AUTH_ID/TOKEN,
# VOBIZ_FROM_NUMBER, SARVAM_API_KEY, OPENAI_API_KEY_VOICE, OPENAI_API_BASE_VOICE,
# LIVEKIT_TOOL_SECRET) are read from the monorepo root .env — do NOT duplicate here.
PIPECAT_PUBLIC_URL=https://media.meshpilot.app/cod-pipecat
PIPECAT_LLM_MODEL=anthropic/claude-haiku-4.5
VOBIZ_ENCODING=audio/x-mulaw
VOBIZ_SAMPLE_RATE=8000
PIPECAT_ELEVENLABS_VOICE_ID=ZUrEGyu8GFMwnHbvLhv2
PIPECAT_ELEVENLABS_MODEL=eleven_multilingual_v2
PIPECAT_ELEVENLABS_STT_MODEL=scribe_v2_realtime
PIPECAT_STT_LANGUAGE=hi
