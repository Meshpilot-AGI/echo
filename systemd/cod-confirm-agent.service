[Unit]
Description=Mesh Pilot COD Confirm — LiveKit voice agent worker (Priya / Sarvam Bulbul v3)
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=support
WorkingDirectory=/home/ubuntu/glitch-grow-ads-agent-private/agents/cod_confirm
EnvironmentFile=/home/ubuntu/glitch-grow-ads-agent-private/.env
Environment=PATH=/home/ubuntu/.npm-global/bin:/usr/local/bin:/usr/bin:/bin
# `start` is production mode (info log, no hot reload). Use `dev` locally for debug.
ExecStart=/usr/bin/node src/livekit-agent.js start
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cod-confirm-agent

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/glitch-grow-ads-agent-private

[Install]
WantedBy=multi-user.target
